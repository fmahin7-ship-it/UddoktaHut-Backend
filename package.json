{
  "name": "uddoktahut-backend",
  "version": "1.0.0",
  "description": "This is uddoktahut backend saas all in one ecomerce app",
  "license": "MIT",
  "author": "Farhan",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types --experimental-transform-types main.ts",
    "start": "node dist/main.js",
    "start:ts": "node --experimental-strip-types --experimental-transform-types main.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:sync-dev": "node --experimental-strip-types --experimental-transform-types scripts/setup-dev-db.ts",
    "db:setup": "docker compose up -d && npm run db:sync-dev && npm run seed-intent-utterances",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "node dist/migrate.js",
    "db:prepare-test": "node --experimental-strip-types --experimental-transform-types scripts/setup-test-db.ts",
    "db:stamp-baseline": "node --experimental-strip-types --experimental-transform-types scripts/stamp-drizzle-baseline.ts",
    "seed-products": "node --experimental-strip-types --experimental-transform-types scripts/seed-products-for-user.ts",
    "seed-intent-utterances": "node --experimental-strip-types --experimental-transform-types scripts/seed-intent-utterances.ts",
    "seed-tool-routing": "npm run seed-intent-utterances",
    "set-store-plan": "node --experimental-strip-types --experimental-transform-types scripts/set-store-plan.ts",
    "ai:eval": "node --experimental-strip-types --experimental-transform-types scripts/run-ai-evals.ts",
    "test": "node --import ./tests/setup-env.ts --experimental-strip-types --experimental-transform-types --experimental-test-module-mocks --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "geoip-country": "^5.0.202610140208",
    "google-libphonenumber": "^3.2.40",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.20",
    "nodemailer": "^6.10.0",
    "openai": "^4.89.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.14.1",
    "stripe": "^23.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.21",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.9",
    "tsup": "^9.0.0",
    "typescript": "^5.9.2"
  }
}
